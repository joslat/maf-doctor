<Project>
  <PropertyGroup>
    <!--
      Central Package Management (CPM) — all <PackageReference> across the
      solution drop their inline Version= and pin here. Matches the
      AgentEval sibling project (C:\git\joslat\AgentEval).

      CentralPackageTransitivePinningEnabled: forces transitive packages
      brought in by direct refs to also resolve to the versions pinned
      below. Required when a security pin (e.g. for a CVE) needs to apply
      to a package we don't reference directly.
    -->
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>

  <ItemGroup>
    <!-- MCP server SDK — provides McpServerToolType, McpServerTool, WithStdioServerTransport, etc.
         Pinned: floating versions made the shipped binary non-reproducible. -->
    <PackageVersion Include="ModelContextProtocol" Version="2.2.0" />

    <!-- BCL / Hosting. The 10.0.x line ships net8/net9/net10 TFMs in one nupkg,
         so a single pin covers all three TargetFrameworks. -->
    <PackageVersion Include="Microsoft.Extensions.Hosting" Version="10.0.12" />

    <!-- YAML parsing — used for registry.yaml and similar. -->
    <PackageVersion Include="YamlDotNet" Version="18.1.0" />

    <!-- Roslyn syntax-tree only (no Workspaces). Used by anti-pattern scanners,
         scaffolders, and the FanOutValidator tool. -->
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp" Version="4.14.0" />
    <PackageVersion Include="Microsoft.CodeAnalysis.Analyzers" Version="3.11.0" />
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp.Analyzer.Testing.XUnit" Version="1.1.2" />

    <!-- Test stack. Pinned to specific versions to keep CI deterministic. -->
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.10.1" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.5" />
    <PackageVersion Include="coverlet.collector" Version="10.1.0" />

    <!-- SourceLink (W.14 / AgentEval parity) — embedded source maps so
         consumers can step into the nupkg's source under the debugger.
         Pinned to the same version AgentEval pins. -->
    <PackageVersion Include="Microsoft.SourceLink.GitHub" Version="10.0.401" />
  </ItemGroup>
</Project>
