<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- Multi-target: NuGet picks the best TFM at install time. Matches the
         AgentEval house style (see docs/architecture.md → "Multi-targeting"). -->
    <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
    <RootNamespace>MafDoctor</RootNamespace>
    <AssemblyName>maf-doctor</AssemblyName>

    <!-- .NET Global Tool packaging -->
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>maf-doctor</ToolCommandName>
    <PackageId>maf-doctor</PackageId>
    <!-- Version policy: decoupled from MAF's version progression — the toolkit
         self-updates its MAF knowledge (see README → "It updates itself").
         release.yml overrides this from the pushed tag and keeps the analyzer
         package in lockstep, so the canonical version is the git tag (`vX.Y.Z`).
         This value is the local/dev default. -->
    <Version>1.16.0</Version>
    <Authors>joslat</Authors>
    <Description>MAF Doctor — a .NET global tool and MCP server for Microsoft Agent Framework (MAF). Diagnoses, explains, and auto-fixes MAF agents and workflows: A-F health grades, deterministic Roslyn rewriters, anti-pattern and fan-out scanning, and a self-updating obsolete-API registry. Use it from Copilot / Claude / Cursor via MCP, or standalone as a CLI.</Description>
    <PackageTags>maf;migration;mcp;dotnet;agents</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/joslat/maf-doctor</RepositoryUrl>
    <PackageReadmeFile>NUGET_README.md</PackageReadmeFile>
    <PackageIcon>MAFDoctorIcon.png</PackageIcon>

    <!-- Ensure logs go to stderr so stdout stays clean for MCP protocol -->
    <AllowUnsafeBlocks>false</AllowUnsafeBlocks>

    <!-- W.14 — symbol package + SourceLink (AgentEval parity).
         Lets consumers step into the toolkit's source under the debugger
         without having to clone this repo locally. -->
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.SourceLink.GitHub" PrivateAssets="All" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="maf-autopilot.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- Versions pinned centrally in /Directory.Packages.props (CPM). -->
    <PackageReference Include="ModelContextProtocol" />
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="YamlDotNet" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Bundle registry.yaml as an embedded resource so the tool works as a standalone NuGet global tool.
      At runtime, RegistryService first checks MAF_REGISTRY_PATH env var (for local dev override),
      then falls back to this embedded resource.
    -->    <!-- NuGet-specific README (pure markdown — the GitHub README's centered
         HTML hero renders as raw text on nuget.org). -->
    <None Include="..\..\NUGET_README.md" Pack="true" PackagePath="\" />
    <None Include="..\..\assets\MAFDoctorIcon.png" Pack="true" PackagePath="\" Visible="false" />

    <!-- Steering snippets — dropped by `maf-autopilot init` into user repos -->
    <EmbeddedResource Include="..\..\docs\steering\copilot-instructions.md"
                      LogicalName="steering/copilot-instructions.md" />
    <EmbeddedResource Include="..\..\docs\steering\claude-instructions.md"
                      LogicalName="steering/claude-instructions.md" />
    <EmbeddedResource Include="..\..\docs\steering\agents.md"
                      LogicalName="steering/agents.md" />
    <EmbeddedResource Include="..\..\docs\steering\cursor-rules.md"
                      LogicalName="steering/cursor-rules.md" />
    <EmbeddedResource Include="..\..\.github\skills\maf-obsolete-api-registry\registry.yaml"
                      LogicalName="registry.yaml" />

    <!-- MAF hard constraints — the non-negotiable rules, served at maf://constraints -->
    <EmbeddedResource Include="..\..\.github\instructions\maf-constraints.instructions.md"
                      LogicalName="constraints.md" />

    <!-- Cumulative, version-keyed migration guide — served at maf://guide -->
    <EmbeddedResource Include="..\..\guides\maf-current-migration-guide.md"
                      LogicalName="guide.md" />
    <!-- Cross-framework migration guide — served at maf://migrate-from?source=semantic-kernel -->
    <EmbeddedResource Include="..\..\docs\migration\from-semantic-kernel-to-maf.md"
                      LogicalName="migrate-from/semantic-kernel.md" />

    <!-- All 15 skill SKILL.md files — served at maf://skills?name=<skill-name> -->
    <EmbeddedResource Include="..\..\.github\skills\cs0618-hunter\SKILL.md"
                      LogicalName="skills/cs0618-hunter.md" />
    <EmbeddedResource Include="..\..\.github\skills\maf-from-semantic-kernel\SKILL.md"
                      LogicalName="skills/maf-from-semantic-kernel.md" />
    <EmbeddedResource Include="..\..\.github\skills\dotnet-inspect\SKILL.md"
                      LogicalName="skills/dotnet-inspect.md" />
    <EmbeddedResource Include="..\..\.github\skills\maf-fan-out-validator\SKILL.md"
                      LogicalName="skills/maf-fan-out-validator.md" />
    <EmbeddedResource Include="..\..\.github\skills\maf-anti-pattern-scanner\SKILL.md"
                      LogicalName="skills/maf-anti-pattern-scanner.md" />
    <EmbeddedResource Include="..\..\.github\skills\maf-migration-guide\SKILL.md"
                      LogicalName="skills/maf-migration-guide.md" />
    <EmbeddedResource Include="..\..\.github\skills\maf-release-watcher\SKILL.md"
                      LogicalName="skills/maf-release-watcher.md" />
    <EmbeddedResource Include="..\..\.github\skills\maf-migration-plan-creator\SKILL.md"
                      LogicalName="skills/maf-migration-plan-creator.md" />
    <EmbeddedResource Include="..\..\.github\skills\maf-migration-retrospective\SKILL.md"
                      LogicalName="skills/maf-migration-retrospective.md" />
    <EmbeddedResource Include="..\..\.github\skills\nuget-diff-analyzer\SKILL.md"
                      LogicalName="skills/nuget-diff-analyzer.md" />
    <EmbeddedResource Include="..\..\.github\skills\maf-obsolete-api-registry\SKILL.md"
                      LogicalName="skills/maf-obsolete-api-registry.md" />
    <EmbeddedResource Include="..\..\.github\skills\maf-workflow-smoke-tester\SKILL.md"
                      LogicalName="skills/maf-workflow-smoke-tester.md" />
    <EmbeddedResource Include="..\..\.github\skills\maf-issue-reporter\SKILL.md"
                      LogicalName="skills/maf-issue-reporter.md" />
    <EmbeddedResource Include="..\..\.github\skills\maf-doctor-self-evolution\SKILL.md"
                      LogicalName="skills/maf-doctor-self-evolution.md" />
    <EmbeddedResource Include="..\..\.github\skills\maf-remediation-playbook\SKILL.md"
                      LogicalName="skills/maf-remediation-playbook.md" />
  </ItemGroup>

</Project>
