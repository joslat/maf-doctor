<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!--
      Roslyn analyzers MUST target netstandard2.0 (this is the host-shared
      compiler surface). The analyzer DLL is loaded into csc.exe / VS / OmniSharp.
    -->
    <TargetFramework>netstandard2.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
    <RootNamespace>MafDoctor.Analyzers</RootNamespace>
    <AssemblyName>maf-doctor.Analyzers</AssemblyName>

    <!-- NuGet packaging -->
    <PackageId>maf-doctor.Analyzers</PackageId>
    <Version>1.18.0</Version>
    <Authors>joslat</Authors>
    <Description>Roslyn analyzers for Microsoft Agent Framework (MAF) — write-time enforcement of fan-out safety, secure credentials, and observability defaults (MAF001-MAF003). Companion to the maf-doctor .NET global tool / MCP server.</Description>
    <PackageTags>maf;agent-framework;analyzer;roslyn;dotnet</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/joslat/maf-doctor</RepositoryUrl>
    <PackageReadmeFile>NUGET_README.md</PackageReadmeFile>
    <PackageIcon>MAFDoctorIcon.png</PackageIcon>
    <DevelopmentDependency>true</DevelopmentDependency>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <SuppressDependenciesWhenPacking>true</SuppressDependenciesWhenPacking>
    <!--
      NU5017 false-positive: NuGet pack's heuristic doesn't see the analyzer DLL
      we ship via `<None Include ... Pack="true">` below — it reports "no
      dependencies nor content" even though `analyzers/dotnet/cs/...dll` IS in
      the package. On Windows it's logged as a warning (exit 0); on Linux CI
      under `bash -e` it's a hard error and kills the release pipeline.
      `<NoPackageAnalysis>true</NoPackageAnalysis>` is the standard fix used by
      Roslyn-sample analyzer csprojs — disables the pack-time analysis checks
      (NU5xxx series) for this project, which is appropriate for analyzer
      packages where the well-known content layout doesn't match the SDK's
      generic-package expectations.
    -->
    <NoPackageAnalysis>true</NoPackageAnalysis>

    <!-- W.14 — symbol package + SourceLink (AgentEval parity). -->
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.SourceLink.GitHub" PrivateAssets="All" />
  </ItemGroup>

  <ItemGroup>
    <!-- Compiler / analyzer base. PrivateAssets keep these out of consumer projects.
         Versions pinned centrally in /Directory.Packages.props (CPM). -->
    <!-- R-03: the analyzer is loaded by the user's compiler, so it must not
         reference a newer Roslyn than the oldest SDK/IDE we support. The tool
         itself moved to Roslyn 5.x (C# 14 parsing); this pin keeps the
         analyzer on 4.14 (with its matching 3.11 authoring analyzers). Guarded by test_analyzer_roslyn_floor.py. -->
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" VersionOverride="4.14.0" PrivateAssets="all" />
    <PackageReference Include="Microsoft.CodeAnalysis.Analyzers" VersionOverride="3.11.0" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <!-- Analyzer release tracking — required to silence RS2008. -->
    <AdditionalFiles Include="AnalyzerReleases.Shipped.md" />
    <AdditionalFiles Include="AnalyzerReleases.Unshipped.md" />
  </ItemGroup>

  <ItemGroup>
    <!-- Ship the analyzer DLL inside the analyzers/ NuGet folder so it's picked up automatically. -->
    <None Include="$(OutputPath)\$(AssemblyName).dll" Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false" />
    <None Include="..\..\NUGET_README.md" Pack="true" PackagePath="\" Visible="false" />
    <None Include="..\..\assets\MAFDoctorIcon.png" Pack="true" PackagePath="\" Visible="false" />
  </ItemGroup>

</Project>
